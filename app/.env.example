# Base URL of the backend API.
# Leave this unset for the iOS Simulator or Android emulator -- the app already picks the
# right default for each (localhost on iOS, 10.0.2.2 on Android). Only set this when testing
# on a physical device, to your machine's LAN IP, e.g. http://192.168.1.42:3000
# EXPO_PUBLIC_API_URL=http://192.168.1.42:3000

