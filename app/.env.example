# Base URL of the backend API.
# Use your machine's LAN IP (not localhost) when testing on a physical device,
# e.g. http://192.168.1.42:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Required for the map to render on Android native builds (Apple Maps is used on
# iOS by default, no key needed there). Without this the Android map is blank.
# See README for how to get one.
ANDROID_GOOGLE_MAPS_API_KEY=

